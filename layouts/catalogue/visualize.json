{{ $entries := slice }}
{{ range where site.RegularPages "Section" "catalogue" }}
  {{ $subsection := path.Base (path.Dir .File.Path) }}
  {{ $yamlData := dict }}
  {{ with .Params.data_id }}
    {{ $allEntries := index site.Data "entries" | default dict }}
    {{ $sectionData := index $allEntries $subsection | default dict }}
    {{ $yamlData = index $sectionData . | default dict }}
  {{ end }}
  {{ $merged := merge .Params $yamlData }}
  {{ $entry := dict
    "id" ($merged.data_id | default .File.ContentBaseName)
    "title" .Title
    "type" ($merged.type | default $subsection)
    "permalink" .RelPermalink
    "tagline" ($merged.tagline | default "")
    "domains" ($merged.domains | default (slice))
    "collaborationTypes" (index $merged "collaboration-types" | default (slice))
    "scales" ($merged.scales | default (slice))
    "modalities" ($merged.modalities | default (slice))
    "researchMethods" ($merged.research_methods | default (slice))
    "maturity" ($merged.maturity | default "")
    "relatedEntries" ($merged.related_entries | default (slice))
    "tags" ($merged.tags | default (slice))
  }}
  {{ $entries = $entries | append $entry }}
{{ end }}

{{ $domains := site.Data.taxonomies.domains | default (slice) }}
{{ $collaborationTypes := index site.Data.taxonomies "collaboration_types" | default (slice) }}
{{ $modalities := site.Data.taxonomies.modalities | default (slice) }}
{{ $scales := site.Data.taxonomies.scales | default (slice) }}
{{ $researchMethods := index site.Data.taxonomies "research_methods" | default (slice) }}
{{ $maturityLevels := index site.Data.taxonomies "maturity_levels" | default (slice) }}

{{- dict "entries" $entries "taxonomies" (dict
  "domains" $domains
  "collaborationTypes" $collaborationTypes
  "modalities" $modalities
  "scales" $scales
  "researchMethods" $researchMethods
  "maturity" $maturityLevels
) | jsonify -}}
